server {
    listen 443 ssl http2;
    server_name admin.starhorizon.ru;

    # ssl_certificate     /etc/letsencrypt/live/admin.starhorizon.ru/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/admin.starhorizon.ru/privkey.pem;

    location / {
        proxy_pass          http://127.0.0.1:27689;
        proxy_http_version  1.1;
        proxy_set_header    Upgrade $http_upgrade;
        proxy_set_header    Connection keep-alive;
        proxy_set_header    Host $host;
        proxy_set_header    X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header    X-Forwarded-Proto https;
        proxy_cache_bypass  $http_upgrade;

        # Necessary to avoid errors from too large headers thanks to large cookies.
        proxy_buffer_size        128k;
        proxy_buffers            4 256k;
        proxy_busy_buffers_size  256k;
    }
}

server {
    listen 80;
    server_name admin.starhorizon.ru;
    location / {
        return 301 https://$host$request_uri;
    }
}
