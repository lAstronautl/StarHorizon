// Фон интро появления: сама игра, но тёмная, зелёная, размытая и пикселизованная,
// как через старый CRT-монитор. Strength возвращает обычную картинку при затухании.

uniform sampler2D SCREEN_TEXTURE;
uniform highp float Strength; // 0..1, насколько эффект перекрывает игру
uniform highp float Glitch;   // 0..1, сила горизонтальных сбоев

void fragment() {
    highp vec2 uv = UV;
    highp vec2 screenSize = vec2(1.0 / SCREEN_PIXEL_SIZE.x, 1.0 / SCREEN_PIXEL_SIZE.y);

    // Крупные "пиксели" вместо чёткой картинки.
    highp vec2 cell = SCREEN_PIXEL_SIZE * 5.0;
    highp vec2 puv = (floor(uv / cell) + 0.5) * cell;

    // Редкие горизонтальные сбои: случайные полосы сдвигаются вбок.
    highp float frame = floor(TIME * 7.0);
    highp float row = floor(uv.y * 45.0);
    highp float g = zRandom(vec2(row * 0.37, frame * 0.91)).x;
    highp float shift = step(0.96, g) * (g - 0.98) * 0.25 * Glitch;
    puv.x += shift;

    // Размытие девятью отсчётами.
    highp vec3 col = vec3(0.0);
    for (int i = -1; i <= 1; i++)
    {
        for (int j = -1; j <= 1; j++)
        {
            col += texture2D(SCREEN_TEXTURE, puv + vec2(float(i), float(j)) * cell * 1.6).rgb;
        }
    }
    col /= 9.0;

    // Зелёный монохром, приглушённый, с тёмной основой.
    highp float lum = dot(col, vec3(0.299, 0.587, 0.114));
    lum = pow(lum, 0.85) * 0.42;
    highp vec3 green = vec3(0.012, 0.045, 0.03) + vec3(0.30, 1.0, 0.5) * lum;

    // Развёртка: тёмные строки через одну.
    highp float scan = 0.80 + 0.20 * sin(FRAGCOORD.y * 3.14159265);
    green *= scan;

    // Медленные широкие полосы, ползущие по экрану.
    highp float band = 0.5 + 0.5 * sin(uv.y * 5.0 - TIME * 0.8);
    green *= 0.9 + 0.2 * band * band;

    // Виньетка.
    highp vec2 d = (uv - 0.5) * vec2(1.0, 0.8);
    highp float vig = 1.0 - smoothstep(0.30, 0.85, length(d)) * 0.85;
    green *= vig;

    // Зерно и лёгкое мерцание. Медленное и узкое, без стробирования.
    highp float grain = zRandom(FRAGCOORD.xy * SCREEN_PIXEL_SIZE + frame * 0.013).x - 0.5;
    green += grain * 0.05;
    green *= 0.96 + 0.04 * sin(TIME * 9.0);

    highp vec3 orig = texture2D(SCREEN_TEXTURE, uv).rgb;
    COLOR = vec4(mix(orig, green, Strength), 1.0);
}
