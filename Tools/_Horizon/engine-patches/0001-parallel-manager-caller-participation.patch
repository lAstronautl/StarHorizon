+        // Horizon: the calling thread takes part in the work instead of sleeping on a kernel wait handle
+        // while pool threads do everything. Batches are claimed through a shared atomic counter.
+        ProcessShared(job, amount);
+    }
+
+    private readonly ObjectPool<SharedParallelJob> _sharedPool =
+        new DefaultObjectPool<SharedParallelJob>(new DefaultPooledObjectPolicy<SharedParallelJob>(), 64);
+
+    private void ProcessShared(IParallelRobustJob job, int amount)
+    {
+        var batchSize = job.BatchSize;
+        var batches = (amount + batchSize - 1) / batchSize;
+
+        // ParallelProcessCount may be the thread pool maximum (tens of thousands), so also clamp to real cores.
+        var helpers = Math.Min(batches, Math.Min(ParallelProcessCount, Environment.ProcessorCount)) - 1;
+
+        if (helpers <= 0)
+        {
+            ProcessSerialNow(job, amount);
+            return;
+        }
+
+        var shared = _sharedPool.Get();
+        shared.Set(_sawmill, job, amount, batchSize, batches, helpers, _sharedPool);
+
+        for (var i = 0; i < helpers; i++)
+        {
+            ThreadPool.UnsafeQueueUserWorkItem(shared, false);
+        }
+
+        shared.Run();
+        shared.Done.Wait();
+        shared.Release();
+    }
+
+    /// <summary>
+    /// A parallel job whose batches are claimed by whichever thread gets there first, including the caller.
+    /// The same instance is queued to the thread pool several times; it returns to its pool only once
+    /// every queued copy has run and the caller has let go of it.
+    /// </summary>
+    private sealed class SharedParallelJob : IThreadPoolWorkItem
+    {
+        public readonly ManualResetEventSlim Done = new(false, 200);
+
+        private ISawmill _sawmill = default!;
+        private IParallelRobustJob _job = default!;
+        private ObjectPool<SharedParallelJob> _pool = default!;
+        private int _amount;
+        private int _batchSize;
+        private int _batches;
+        private int _next;
+        private int _pending;
+        private int _refs;
+
+        public void Set(ISawmill sawmill, IParallelRobustJob job, int amount, int batchSize, int batches, int helpers,
+            ObjectPool<SharedParallelJob> pool)
+        {
+            _sawmill = sawmill;
+            _job = job;
+            _pool = pool;
+            _amount = amount;
+            _batchSize = batchSize;
+            _batches = batches;
+            _next = 0;
+            _pending = batches;
+            // One reference per queued copy plus one for the caller.
+            _refs = helpers + 1;
+            Done.Reset();
+        }
+
+        public void Run()
+        {
+            var job = _job;
+            int batch;
+            while ((batch = Interlocked.Increment(ref _next) - 1) < _batches)
+            {
+                var start = batch * _batchSize;
+                var end = Math.Min(start + _batchSize, _amount);
+
+                try
+                {
+                    for (var i = start; i < end; i++)
+                    {
+                        job.Execute(i);
+                    }
+                }
+                catch (Exception exc)
+                {
+                    _sawmill.Error($"Exception in ParallelManager: {exc}");
+                }
+
+                if (Interlocked.Decrement(ref _pending) == 0)
+                    Done.Set();
+            }
+        }
+
+        public void Execute()
+        {
+            Run();
+            Release();
+        }
+
+        public void Release()
+        {
+            if (Interlocked.Decrement(ref _refs) != 0)
+                return;
+
+            _job = default!;
+            _pool.Return(this);
+        }
     }
 
     /// <inheritdoc/>
