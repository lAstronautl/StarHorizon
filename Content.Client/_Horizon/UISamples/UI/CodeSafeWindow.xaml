<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'Кодовый сейф'}"
                      MinSize="300 220">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <Label Name="StatusLabel" Text="Закрыт" StyleClasses="LabelHeading" Align="Center"/>
        <LineEdit Name="CodeEdit" HorizontalExpand="True" PlaceHolder="код из 4 цифр"/>
        <Button Name="OpenButton" Text="Открыть"/>
        <Label Name="AttemptsLabel" Text="Ошибок: 0" StyleClasses="LabelSubText"/>
    </BoxContainer>
</controls:FancyWindow>
