<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      Title="{Loc 'ui-samples-cargo-title'}"
                      MinSize="620 380">
    <BoxContainer Orientation="Horizontal" Margin="6">
        <BoxContainer Orientation="Vertical"
                      HorizontalExpand="True"
                      SizeFlagsStretchRatio="1.5"
                      SeparationOverride="4">
            <LineEdit Name="SearchBar" HorizontalExpand="True" PlaceHolder="{Loc 'ui-samples-cargo-search'}"/>
            <PanelContainer VerticalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1B1B1E" BorderColor="#3B3E56" BorderThickness="1"/>
                </PanelContainer.PanelOverride>
                <ItemList Name="ProductList" VerticalExpand="True" SelectMode="Single"/>
            </PanelContainer>
        </BoxContainer>
        <BoxContainer Orientation="Vertical" MinWidth="220" Margin="8 0 0 0" SeparationOverride="4">
            <Label Name="ProductName" Text="{Loc 'ui-samples-cargo-no-selection'}" StyleClasses="LabelHeading"/>
            <RichTextLabel Name="ProductDescription" Text=" "/>
            <GridContainer Columns="2" HSeparationOverride="6" VSeparationOverride="4">
                <Label Text="{Loc 'ui-samples-cargo-amount'}"/>
                <SpinBox Name="AmountSpin" HorizontalExpand="True"/>
                <Label Text="{Loc 'ui-samples-cargo-reason'}"/>
                <LineEdit Name="ReasonEdit" HorizontalExpand="True"/>
            </GridContainer>
            <Control VerticalExpand="True"/>
            <Label Name="BalanceLabel" Text="{Loc 'ui-samples-cargo-balance'}" StyleClasses="LabelSubText"/>
            <Button Name="OrderButton" Text="{Loc 'ui-samples-cargo-order'}" StyleClasses="ButtonColorGreen"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
