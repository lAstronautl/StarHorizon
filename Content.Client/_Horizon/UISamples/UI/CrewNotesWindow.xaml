<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'ui-samples-notes-title'}"
                      MinSize="400 320">
    <BoxContainer Orientation="Vertical" Margin="4">
        <TabContainer VerticalExpand="True">
            <BoxContainer Name="NotesTab"
                          Orientation="Vertical"
                          Margin="4"
                          TabContainer.TabTitle="{Loc 'ui-samples-notes-tab-notes'}">
                <TextEdit Name="NotesEdit" MinHeight="60" VerticalExpand="True"/>
                <BoxContainer Orientation="Horizontal" Margin="0 4 0 0">
                    <Label Name="CharCountLabel"
                           Text="0/1000"
                           StyleClasses="LabelSubText"
                           HorizontalExpand="True"/>
                    <Button Name="SaveNotesButton" Text="{Loc 'ui-samples-notes-save'}"/>
                </BoxContainer>
            </BoxContainer>
            <BoxContainer Name="SettingsTab"
                          Orientation="Vertical"
                          Margin="8"
                          SeparationOverride="6"
                          TabContainer.TabTitle="{Loc 'ui-samples-notes-tab-settings'}">
                <CheckBox Name="AutoSaveCheck" Text="{Loc 'ui-samples-notes-autosave'}" Pressed="True"/>
                <Label Text="{Loc 'ui-samples-notes-font-size'}"/>
                <Slider Name="FontSizeSlider" MinValue="8" MaxValue="24" Value="12" HorizontalExpand="True"/>
                <Label Text="{Loc 'ui-samples-notes-theme'}"/>
                <OptionButton Name="ThemeOption"/>
            </BoxContainer>
        </TabContainer>
    </BoxContainer>
</controls:FancyWindow>
