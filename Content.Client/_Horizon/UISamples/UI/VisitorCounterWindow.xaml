<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      Title="{Loc 'Счётчик посетителей'}"
                      MinSize="320 200">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="6">
        <Label Name="CountLabel" Text="0" StyleClasses="LabelHeadingBigger" Align="Center"/>
        <Label Name="LastLabel" Text="Пока никого" StyleClasses="LabelSubText" Align="Center"/>
        <Control VerticalExpand="True"/>
        <BoxContainer Orientation="Horizontal" SeparationOverride="4">
            <Button Name="PlusButton" Text="Отметиться (+1)" HorizontalExpand="True"/>
            <controls:ConfirmButton Name="ResetButton"
                                    Text="Сбросить"
                                    StyleClasses="Caution"
                                    HorizontalExpand="True"/>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
