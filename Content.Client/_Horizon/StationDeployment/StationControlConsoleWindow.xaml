<controls:FancyWindow xmlns="https://spacestation14.io"
               xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
               Title="{Loc 'station-control-console-window-title'}"
               MinSize="250 100">
    <BoxContainer Orientation="Vertical" Margin="5">
        <Label Text="{Loc 'station-control-console-name-info'}" />
        <BoxContainer Orientation="Horizontal" Margin="5">
            <LineEdit Name="NameSelector" HorizontalExpand="True" />
            <Button Name="NameSelectorSet" Text="{Loc 'station-control-console-name-set'}" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
